<Project>

  <!--
    ONE place the version is written. Program.ServerVersion reads it back off the assembly rather
    than repeating it as a literal. Windows-mcp learned this the expensive way: a hardcoded "0.4.1"
    survived three releases, and a server that misreports its own version makes a stale-bundle
    deploy invisible - the deploy looks fine because the thing you ask is the thing that is wrong.
  -->
  <PropertyGroup>
    <Version>0.1.6</Version>
    <Authors>danielsimonjr</Authors>
    <Company>danielsimonjr</Company>
    <Product>ui-mcp</Product>
  </PropertyGroup>

  <!--
    Reproducible output. The same source must build to the same bytes on every machine, or the
    committed bundle/UiMcp.exe cannot be checked against a CI rebuild. Without these four
    properties a build embeds the checkout path (PDB data) and the commit (SourceLink data and
    the informational version), so every path and every commit gives a different file.
    The line endings of the .cs files also change the bytes: the PDB stores a checksum of each
    source file. The .gitattributes file pins them to CRLF for every checkout. The SDK is pinned in
    global.json, and dotnet reads that file from the working directory, so build from inside the clone.
  -->
  <PropertyGroup>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

</Project>
