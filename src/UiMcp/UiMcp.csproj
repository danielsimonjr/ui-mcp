<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      The WPF SDK generates an entry point for Application-derived apps. This server owns its own
      Main: the process must start as an MCP stdio server and create the UI thread itself, never the
      other way round. SPEC section 3: tool handlers never touch WPF directly and the UI thread never
      blocks MCP.
    -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiMcp.Abstractions\UiMcp.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Exact versions, not "9.*". A floating range makes the bundle depend on the day it is
      built, and no update tool can track it. To update: list the newer versions with the
      outdated option of dotnet list package, move both versions together, run dotnet test,
      rebuild bundle/UiMcp.exe and commit it.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.21" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiMcp.Tests" />
  </ItemGroup>

</Project>
